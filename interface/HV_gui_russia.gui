@russia_alignment_window_height = 140

guiTypes = {

	### russia Aligment GUI ###
	containerWindowType = {
		name = "russia_alignment_gui_button_window"
		position = { x = 0 y = 10 }
		size = { width = 180 height = 45 }

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_window_small"
			alwaystransparent = yes
		}

		buttonType = {
			name = "russia_alignment_gui_button"
			position = { x = 0 y = 0 }
			spriteType = "GFX_russia_alignment_gui_button"
			clicksound = click_ok
			oversound = ui_menu_over
			pdx_tooltip = russia_alignment_gui_button_tooltip
		}

		iconType = {
			name = "russia_alignment_icon"
			position = { x = 5 y = 5 }
			spriteType = "GFX_russia_alignment_icon_communist"
			scale = 0.8
			alwaystransparent = yes
		}

		iconType = {
			name = "russia_alignment_icon2"
			position = { x = 5 y = 5 }
			spriteType = "GFX_russia_alignment_icon_non_communist"
			scale = 0.8
			alwaystransparent = yes
		}

		iconType = {
			name = "russia_alignment_icon3"
			position = { x = 5 y = 5 }
			spriteType = "GFX_russia_alignment_icon"
			scale = 0.8
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "russia_alignment_title"
			position = { x = 45 y = 12 }
			text = russia_alignment_gui_button_text
			font = "hoi_18mbs"
			format = left
			maxWidth = 500
			alwaystransparent = yes
		}
	}

	containerWindowType = {
		name = "russia_alignment_gui_window"
		position = { x = -500 y = -250 }
		size = { width = 960 height = 580 }

		hide_position = { x = -500 y = -1000 }

		moveable = yes
		show_animation_type = decelerated
		hide_animation_type = accelerated
		animation_time = 300
		click_to_front = yes

		orientation = CENTER

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_plain_bg"
		}

		containerWindowType = {
			name = "russia_alignment_title_container"
			position = { x = 0 y = 0 }
			size = { width = 960 height = 40 }

			background = {
				name = "Background"
				spriteType = "GFX_tiled_header_1"
				alwaystransparent = yes
			}

			instantTextBoxType = {
				name = "russia_alignment_title"
				position = { x = 215 y = 0 }
				borderSize = { x = 0 y = 0 }
				text = "russia_alignment_title_text"
				font = "hoi_36header"
				format = center
				maxWidth = 500
			}

			buttonType = {
				name = "russia_alignment_button_close"
				position = { x = -36 y = 4 }
				spriteType = "GFX_closebutton"
				clicksound = click_close
				pdx_tooltip = "CLOSE"
				shortcut = "ESCAPE"
				orientation = UPPER_RIGHT
			}
		}

		containerWindowType = {
			name = "russia_alignment_list_container"
			position = { x = 0 y = 36 }
			size = { width = 100% height = 543 }
			Orientation = UPPER_LEFT

			background = {
				name = "Background"
				quadTextureSprite = "GFX_tiled_research_bg"
				alwaystransparent = yes
			}

			containerWindowType = {
				name = "russia_alignment_leaders_grid_container"
				position = { x = 8 y = 10 }
				size = { width = 944 height = 540 }
				margin = { top = 0 bottom = 8 }
				scroll_wheel_factor = 10
				smooth_scrolling = yes
				Orientation = UPPER_LEFT

				verticalScrollbar = "right_vertical_slider"

				background = {
					name = "Background"
					spriteType ="GFX_tiled_window_transparent"
					alwaystransparent = yes
				}

				gridboxtype = {
					name = "russia_alignment_leaders_grid"
					position = { x = 0 y = 0 }
					size = { width = 100%% height = 100%% }
					slotsize = { width = 470 height = 130 }
					max_slots_horizontal = 2
					format = "UPPER_LEFT"
				}
			}
		}
	}

	containerWindowType = {
		name = "russia_alignment_leaders_entry"
		#position = { x = 0 y = 0 }
		size = { width = 478 height = @russia_alignment_window_height }
		orientation = UPPER_LEFT

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_bg"
			alwaystransparent = yes
		}

		iconType = {
			name = "russia_alignment_leaders_flag"
			quadTextureSprite = "GFX_player_flag"
			#position = { x = 5 y = 4 } original position
			position = { x = 18 y = 15 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}

		iconType = {
			name = "russia_alignment_leaders_flag_frame"
			spriteType = "GFX_large_flag_frame"
			#spriteType = "GFX_diplo_countrylist_flag_frame"
			position = { x = 13 y = 11 }
		}

		instantTextBoxType = {
			name = "russia_alignment_faction_title"
			position = { x = 65 y = 20 }
			text = "[russiaGetAlignmentTitleName]"
			font = "hoi_18mbs"
			format = left
			maxWidth = 500
		}

		instantTextBoxType = {
			name = "russia_alignment_faction_desc"
			position = { x = 20 y = 45 }
			text = "[russiaGetAlignmentDesc]"
			font = "hoi_16mbs"
			format = left
			maxWidth = 340
		}

		containerWindowType = {
			name = "russia_alignment_members_container"
			position = { x = 12 y = 75 }
			size = { width = 344 height = 60 }
			margin = { top = 4 bottom = 4 left = 4 right = 4 }
			smooth_scrolling = yes

			background = {
				name = "Background"
				spriteType ="GFX_tiled_window_transparent"
				alwaystransparent = yes
			}

			horizontalScrollbar = "bottom_horizontal_slider"

			gridboxtype = {
				name = "russia_alignment_members"
				position = { x = 0 y = 0 }
				size = { width = 100%% height = 100%% }
				#slotsize = { width = 52 height = 38 } original size
				slotsize = { width = 48 height = 38 }
				max_slots_vertical = 1
				add_horizontal = yes
				format = "UPPER_LEFT"
			}
		}
	}

	containerWindowType = {
		name = "russia_alignment_members_entry"
		size = { width = 48 height = 60 }
		orientation = UPPER_LEFT

		iconType = {
			name = "russia_alignment_flag"
			quadTextureSprite = "GFX_flag_small2"
			#position = { x = 5 y = 4 } original position
			position = { x = 5 y = 4 }
			Orientation = "UPPER_LEFT"
			alwaystransparent = yes
		}

		iconType = {
			name = "russia_alignment_flag_frame"
			spriteType = "GFX_diplo_countrylist_flag_frame"
			position = { x = 0 y = 0 }
			pdx_tooltip = russia_alignment_faction_member_name
		}
	}
}
