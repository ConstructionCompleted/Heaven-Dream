@holy_map_x = 45
@holy_map_y = 15

guiTypes = {
	
	### holy meeting GUI ###
	containerWindowType = {
		name = "holy_meeting"
		position = { x = 0 y = 10 }
		size = { width = 96%% height = 300 }

		background = {
			name = "Background"
			quadTextureSprite = "GFX_tiled_paper_bg"
		}

		iconType = {
			name = "holy_meeting_map"
			position = { x = @holy_map_x y = @holy_map_y }
			spriteType = "GFX_holy_meeting_map"
			#alwaystransparent = yes
		}
		
		containerWindowType = {
			name = "holy_meeting_select_country"
